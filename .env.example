# API
PORT=3333
# DATA_FILE=C:\caminho\seguro\guiaconcursos-data.json

# Catálogo contínuo
# Um ou mais endpoints HTTPS separados por vírgula. Cada endpoint deve seguir
# o contrato descrito em docs/ATUALIZACAO_CATALOGO.md.
CATALOG_FEED_URLS=
CATALOG_REFRESH_MINUTES=15

# Radar municipal de descoberta (Querido Diário). Ativo por padrão fora de testes.
# Os resultados entram como sinais pendentes; nunca viram card sem validação oficial.
CATALOG_DISCOVERY_ENABLED=true
CATALOG_DISCOVERY_REFRESH_MINUTES=60
CATALOG_DISCOVERY_LOOKBACK_DAYS=30
CATALOG_DISCOVERY_MAX_PAGES_PER_RUN=5
# Em produção, aponte para um volume persistente fora da imagem da aplicação.
# CATALOG_DISCOVERY_LOG_FILE=C:\caminho\persistente\discovery-events.ndjson

# Obrigatório para acionar POST /api/catalog/refresh por cron/webhook.
CATALOG_REFRESH_TOKEN=troque-por-um-segredo-longo-e-aleatorio

# Obrigatório para consultar as filas privadas de revisão.
CATALOG_REVIEW_TOKEN=troque-por-outro-segredo-longo-e-aleatorio

# Opcional para autenticar a leitura de todos os feeds sem colocar segredo na URL.
CATALOG_FEED_BEARER_TOKEN=

# Opcional, mas recomendado para o feed editorial próprio. Quando definido,
# toda resposta precisa trazer x-catalog-signature: sha256=<HMAC do corpo>.
CATALOG_FEED_HMAC_SECRET=

# CATALOG_CACHE_FILE=C:\caminho\seguro\catalog-cache.json

# Indicações enviadas pelo formulário público. Em produção, use volume persistente;
# para múltiplas réplicas, migre a fila para Postgres/serviço transacional.
# CATALOG_SUGGESTIONS_FILE=C:\caminho\persistente\catalog-suggestions.ndjson

# Quantos proxies reversos confiáveis existem entre a internet e o Express.
# Configure corretamente para o rate limit não enxergar todos como um único IP.
# TRUST_PROXY_HOPS=1
